{
  "manifest_version": 3,
  "name": "Vectorize.ai Download",
  "version": "1.0.0",
  "key": "",
  "description": "Export and download vector graphics (SVG/PNG) directly from Vectorize.ai and Vectorizer.ai free previews.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vectorize.ai Download",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://vectorizer.ai/*",
    "*://*.vectorizer.ai/*",
    "*://vectorize.ai/*",
    "*://*.vectorize.ai/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vectorizer.ai/*",
        "*://*.vectorizer.ai/*",
        "*://vectorize.ai/*",
        "*://*.vectorize.ai/*"
      ],
      "js": [
        "injected/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://vectorizer.ai/*",
        "*://*.vectorizer.ai/*",
        "*://vectorize.ai/*",
        "*://*.vectorize.ai/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/inject.js",
        "icons/*"
      ],
      "matches": [
        "*://vectorizer.ai/*",
        "*://*.vectorizer.ai/*",
        "*://vectorize.ai/*",
        "*://*.vectorize.ai/*"
      ]
    }
  ]
}